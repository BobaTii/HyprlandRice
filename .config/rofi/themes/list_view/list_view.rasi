configuration {
  modi: "drun";
  show-icons: false;
  drun-display-format: "{name}";
}

@import "/home/minessh/.config/rofi/themes/colors/catppuccin.rasi"

window {
  width:            200px;
  background-color: @background;
  
  border:           4px; 
  border-color:     @selected;
  border-radius:    4px;
  
  padding:          15px;
}

mainbox {
  background-color: @background;
  border:           0px;
  padding:          0px;
  children:         [ listview ];
}

listview {
  background-color: @background;
  columns:          1;
  lines:            5;
  spacing:          4px;
  cycle:            true;
  border:           0px;
  scrollbar:        false;
}

element {
  background-color: @background;
  text-color:       @selected;
  padding:          6px 10px;
  border-radius:    2px;
}

element selected {
  background-color: @background-alt;
  text-color:       @selected-alt;
}

element-text, element-icon {
  background-color: inherit;
  text-color:       inherit;
}
